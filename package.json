{
  "name": "uofa-prof-insights",
  "version": "1.0.2",
  "description": "View Rate My Professors ratings while browsing classes in UAccess.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "npm run build && node scripts/package.mjs",
    "verify:browser": "npm run build && node scripts/verify-browser.mjs",
    "verify:extension": "npm run build && node scripts/verify-extension.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --mode live tests/live",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "chrome-extension",
    "uaccess",
    "ratemyprofessor",
    "university-of-arizona"
  ],
  "author": "Ohm Bajaj",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ohmbajaj/uofa-prof-insights.git"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
